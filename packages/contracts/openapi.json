{
  "components": {
    "schemas": {
      "CompactionMetadata": {
        "description": "Opaque, unauthenticated-to-the-server compaction bookkeeping. Its exact\nauthenticated copy is carried in the encrypted event payload by clients.\nIt deliberately stays out of legacy AAD and `wire_digest`.",
        "properties": {
          "checkpoint": {
            "description": "Authenticated maintenance marker: this record repeats its producer's current state\nonly to fold a large unsuperseded frontier. Readers apply it as history (no OS,\nbanner or unread effects). Omitted when false, so legacy encodings are unchanged.",
            "type": "boolean"
          },
          "key": {
            "type": "string"
          },
          "supersedes": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/CompactionReference"
            },
            "type": "array"
          },
          "terminal": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "key"
        ],
        "type": "object"
      },
      "CompactionReference": {
        "properties": {
          "producer_device_id": {
            "format": "uuid",
            "type": "string"
          },
          "producer_sequence": {
            "$ref": "#/components/schemas/SourceSequence"
          }
        },
        "required": [
          "producer_device_id",
          "producer_sequence"
        ],
        "type": "object"
      },
      "Envelope": {
        "properties": {
          "ciphertext": {
            "type": "string"
          },
          "command_id": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "compaction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompactionMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "crypto_suite": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "envelope_id": {
            "format": "uuid",
            "type": "string"
          },
          "key_epoch": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "producer_device_id": {
            "format": "uuid",
            "type": "string"
          },
          "producer_sequence": {
            "$ref": "#/components/schemas/SourceSequence"
          },
          "profile_fingerprint": {
            "type": "string"
          },
          "protocol_version": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "purpose": {
            "$ref": "#/components/schemas/EnvelopePurpose"
          },
          "route": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GatewayRoute"
              },
              {
                "type": "null"
              }
            ]
          },
          "vault_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "protocol_version",
          "envelope_id",
          "vault_id",
          "producer_device_id",
          "producer_sequence",
          "key_epoch",
          "crypto_suite",
          "profile_fingerprint",
          "purpose",
          "ciphertext"
        ],
        "title": "Envelope",
        "type": "object"
      },
      "EnvelopePurpose": {
        "enum": [
          "command",
          "event"
        ],
        "type": "string"
      },
      "GatewayRoute": {
        "properties": {
          "gateway_device_id": {
            "format": "uuid",
            "type": "string"
          },
          "subscription_id": {
            "type": "string"
          }
        },
        "required": [
          "gateway_device_id",
          "subscription_id"
        ],
        "type": "object"
      },
      "PairingQrRecord": {
        "properties": {
          "challenge_token": {
            "type": "string"
          },
          "device_binding": {
            "format": "uuid",
            "type": "string"
          },
          "expires_at_unix_seconds": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "https_origin": {
            "type": "string"
          },
          "key_epoch": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "profile_fingerprint": {
            "type": "string"
          },
          "protocol_version": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "vault_id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "https_origin",
          "challenge_token",
          "expires_at_unix_seconds",
          "protocol_version",
          "vault_id",
          "key_epoch",
          "profile_fingerprint",
          "device_binding"
        ],
        "title": "PairingQrRecord",
        "type": "object"
      },
      "SourceSequence": {
        "type": "string"
      }
    }
  },
  "info": {
    "title": "OpenPush protocol",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {}
}
