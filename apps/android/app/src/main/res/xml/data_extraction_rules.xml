<?xml version="1.0" encoding="utf-8"?>
<!-- Keystore-wrapped secrets and the SQLCipher database must never be backed up or transferred:
     the wrapping key is device-bound, so a restored copy would be unusable or would fork state. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
